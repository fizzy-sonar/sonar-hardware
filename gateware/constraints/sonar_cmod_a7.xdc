## On-module USB-UART bridge (FT2232HQ) - D012 snapshot drain over the Cmod's
## own USB. uart_rxd_out is the FPGA's TX pin (drives the bridge RXD), J18.
## uart_txd_in (J17) stays unconstrained until a control plane needs RX.
set_property -dict { PACKAGE_PIN J18   IOSTANDARD LVCMOS33 } [get_ports { uart_rxd_out }]; #IO_L7N_T1_D10_14 Sch=uart_rxd_out
