; RP2350 PIO capture primitive. One SM drives PDM_CLK; a second samples 12 pins.
; The production build routes its RX FIFO through a DMA channel configured for byte
; packing, with the DMA transfer count equal to 3 * requested logical frames.
.program pdm_clock
.side_set 1
    set pins, 0 side 0
    set pins, 1 side 1

.program pdm_sample
.side_set 1
; Wait/sampling edges are explicit: rising bits become CH even, falling CH odd.
; CPU/DMA packing interleaves the two 12-bit words into little-endian 24-bit frames.
wrap_target
    wait 1 pin 0 side 0
    in pins, 12
    wait 0 pin 0 side 0
    in pins, 12
    push block
wrap
