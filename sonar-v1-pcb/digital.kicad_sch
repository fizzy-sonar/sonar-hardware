	(text "J41: 1x20 0.1in header matching the Adafruit FT232H breakout (#2264): pin1=5V (NC), pin2=GND, pins3-10=D0-D7,\npins11-20=C0-C9. Sync-FIFO (FT245) mapping: C0=RXF#, C1=TXE#, C2=RD#, C3=WR#, C4=SIWU (FPGA tie option),\nC5=CLKOUT (60 MHz, to clock-capable pio47), C6=OE#, C7-C9 unused (NC). Breakout VCCIO is 3.3 V.\nVERIFY the physical breakout pin order against the Adafruit board at layout (net identities are what matter)."
		(exclude_from_sim no)
		(at 262 135 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2f8c2ae8-46d0-440e-aba1-12794dbd6d2b")
	)
