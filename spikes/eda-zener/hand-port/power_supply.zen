# Sonar v1 power-supply fragment, ported from sonar-v1-pcb/power_supply.kicad_sch
# (post-T-012 four-rail tree). SIMPLIFIED and UNVERIFIED: `pcb build` cannot run
# in the agent sandbox (hardlink/home-write EPERM — see ../REPORT.md §Blocked).
#
# Scope: +5V -> +3.3V buck (AP63301, R_div = 31.6k/10k) and the 3V3_MIC
# ferrite-filtered branch (FB: 120R@100MHz, 0R series). The +12V boost sheet
# (5v_to_12v_boost.kicad_sch) is NOT ported here.

load("@stdlib/interfaces.zen", "Net", "Power", "Ground")
load("@stdlib/checks.zen", "voltage_within")
load("@stdlib/units.zen", "Voltage")

Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
Inductor = Module("@stdlib/generics/Inductor.zen")
FerriteBead = Module("@stdlib/generics/FerriteBead.zen")
TestPoint = Module("@stdlib/generics/TestPoint.zen")
AP63301 = Module("ap63301.zen")

Board(
    name="power_supply",
    layout_path="layout",
    layers=4,
)

# ---- Rails ----------------------------------------------------------------
v5 = Power("+5V", voltage=Voltage("5V 5%"))
v33 = Power("+3.3V", voltage=Voltage("3.3V 2%"))
gnd = Ground("GND")

# 3V3_MIC is derived from +3.3V through a ferrite; declare the same rail spec.
v33_mic = Power("3V3_MIC", voltage=Voltage("3.3V 2%"))

# ERC-equivalent: rail voltage sanity (stdlib electrical check, runs at build).
voltage_within("5V 10%")(v5)
voltage_within("3.3V 5%")(v33)
voltage_within("3.3V 5%")(v33_mic)

# ---- +5V input bulk/decoupling ---------------------------------------------
Capacitor(name="C_IN1", value="22uF 20%", package="0805", voltage="16V", P1=v5, P2=gnd)
Capacitor(name="C_IN2", value="100nF 10%", package="0603", dielectric="X7R", P1=v5, P2=gnd)

# ---- AP63301 buck: +5V -> +3.3V --------------------------------------------
sw = Net("SW")
vfb = Net("FB")

AP63301(name="U_BUCK", VIN=v5, EN=v5, SW=sw, PGND=gnd, FB=vfb)

# BST bootstrap cap (BST->SW) requires referencing the module's BST pin net;
# in a verified port this would be `U_BUCK.BST`. Left explicit but unverified.
Capacitor(name="C_BST", value="100nF 10%", package="0603", dielectric="X7R", P1=Net("BST"), P2=sw)

Inductor(name="L_BUCK", value="2.2uH", package="1210", P1=sw, P2=v33)

# Feedback divider: 31.6k top, 10k bottom -> Vout = 0.8V * (1 + 31.6/10) = 3.33V
Resistor(name="R_FB_TOP", value="31.6kOhm 1%", package="0603", P1=v33, P2=vfb)
Resistor(name="R_FB_BOT", value="10kOhm 1%", package="0603", P1=vfb, P2=gnd)
# EN pull-down (100k) from the KiCad sheet
Resistor(name="R_EN", value="100kOhm 5%", package="0603", P1=v5, P2=gnd)

# Output bulk
Capacitor(name="C_OUT1", value="22uF 20%", package="0805", voltage="10V", P1=v33, P2=gnd)
Capacitor(name="C_OUT2", value="22uF 20%", package="0805", voltage="10V", P1=v33, P2=gnd)
Capacitor(name="C_OUT3", value="100nF 10%", package="0603", dielectric="X7R", P1=v33, P2=gnd)
Capacitor(name="C_OUT4", value="1uF 10%", package="0603", voltage="16V", P1=v33, P2=gnd)

# ---- 3V3_MIC filtered branch (>=100 mA per T-008) ---------------------------
FerriteBead(name="FB_MIC", impedance="120Ohm", frequency="100MHz", package="0603", P1=v33, P2=v33_mic)
Resistor(name="R_MIC_0R", value="0Ohm", package="0603", P1=v33, P2=v33_mic)
Capacitor(name="C_MIC1", value="10uF 20%", package="0603", voltage="10V", P1=v33_mic, P2=gnd)
Capacitor(name="C_MIC2", value="100nF 10%", package="0603", dielectric="X7R", P1=v33_mic, P2=gnd)

# ---- Rail test points (rails.md bring-up table) -----------------------------
TestPoint(name="TP_5V", P1=v5)
TestPoint(name="TP_3V3", P1=v33)
TestPoint(name="TP_3V3MIC", P1=v33_mic)
